{
  "permissions": {
    "allow": [
      "Read(//root/$repo/.claude/**)"
    ],
    "additionalDirectories": [
      "/root/.claude/projects/-root-xloud-horizon-2025-1-v2",
      "/root/.claude/projects/-root-xloud-nova-2025-1-v2",
      "/root/.claude/projects/-root-watcher-2025-1/memory",
      "/root/.claude/projects/-root-xavs-ansible/memory",
      "/root/xloud-horizon-2025.1-v2/.claude",
      "/root/xloud-nova-2025.1-v2/.claude",
      "/root/watcher-2025.1/.claude",
      "/root/xavs-ansible/.claude",
      "/root/xloud-horizon-2025.1-v2/.claude/hooks",
      "/root/xloud-nova-2025.1-v2/.claude/hooks",
      "/root/watcher-2025.1/.claude/hooks",
      "/root/xavs-ansible/.claude/hooks"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-write-check.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-write-validate.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-reminder.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
